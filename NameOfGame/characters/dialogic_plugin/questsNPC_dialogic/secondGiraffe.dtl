if {quest_giraffe} == "completed":
    giraffe: Geweldig! Ik heb ze bekeken en het lijkt erop dat dit met het magische wezen te maken heeft.
    [end_timeline]

if {quest_giraffe} == "active" and {quest_objective_met} == true:
    [signal arg="freeze_player"]
    giraffe: Hé! Je hebt alle 5 de paarse kristallen verzameld. Wil je ze nu aan mij geven?
    - Ja, hier zijn ze!
        set {quest_giraffe} = "completed"
        giraffe: Geweldig! Ik heb ze bekeken en het lijkt erop dat dit met het magische wezen te maken heeft.
        [signal arg="add_coins"]
        [signal arg="unfreeze_player"]
        [end_timeline]