if {quest_hippo} == "completed":
	hippo: Deze taak heb je al voltooid, avonturier. De savanne is je dankbaar!
	[end_timeline]

if {hippoQuest} == true:
	jump quest_return

[signal arg="freeze_player"]
join hippo right
hippo: Hé avonturier! Ik zit met een groot probleem…
hippo: Door de droogte is al het voedzame gras verdwenen.
hippo: Zonder dat gras kan mijn kudde de zomer niet overleven.
join hippo_grass center
hippo: Zou jij 5 bundels vers gras voor me kunnen verzamelen?
leave hippo_grass

- Ja, ga ik doen!
	hippo: Geweldig! Je helpt niet alleen mij, maar de hele savanne.
	set {quest_hippo} = "active"
	[signal arg="unfreeze_player"]

- Nee, ga ik niet doen
	hippo: Dat begrijp ik… hopelijk vindt iemand anders tijd om te helpen.
	[signal arg="unfreeze_player"]
	[end_timeline]

label quest_start
[signal arg="hippoQuest"]
[end_timeline]

label quest_return
if {quest_hippo} != "active":
	[end_timeline]

if {quest_objective_met} == false:
	hippo: Je hebt nog niet genoeg gras gevonden. Blijf zoeken, avonturier!
	[end_timeline]

if {quest_objective_met} == true:
	[signal arg="freeze_player"]
	hippo: Je hebt al het gras gevonden!
	hippo: Nog één laatste test om te zien of je scherp bent…
	hippo: Wat is 170 + 90?
	
	- 260
		jump Goed
	- 250
		jump Fout
	- 270
		jump Fout

label Goed
label quest_complete
set {quest_hippo} = "completed"
[signal arg="add_coins"]
hippo: Fantastisch werk! Dankzij jou kan mijn kudde weer vooruit.
hippo: Jij bent een echte beschermer van de savanne!
[signal arg="unfreeze_player"]
set {hippoQuest} = false
[end_timeline]

label Fout
hippo: Helaas, dat is niet juist. Probeer het nog eens!
jump quest_return